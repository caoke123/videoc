{
  "project_name": "Ecommerce UGC Video Studio",
  "default_mode": "original",
  "default_category_id": "seatbelt-shoulder-pad",
  "category_catalog": "production/config/categories.json",
  "default_aspect_ratio": "9:16",
  "default_review_policy": "human_first",
  "automatic_ai_review": false,
  "automatic_retry": false,
  "asset_self_check_required": true,
  "asset_self_check_policy": "required before promotion; no automatic regeneration; human approval remains required",
  "product_catalog": "production/config/products.json",
  "paid_runs_require_confirmation": true,
  "integrations": {
    "reference_video_analysis": "claude-video-watch",
    "video_generation": "minimax-h3",
    "prompt_compiler": "h3-prompt-writing",
    "voice_generation": "seed-audio-1.0-external-user-step",
    "voice_policy": "assistant-prepares-per-shot-brief-user-generates-and-imports",
    "h3_audio_policy": "required-native-dialogue-or-voiceover-for-every-h3-shot-then-replace-as-needed",
    "voiceover_handoff": "production/integrations/seed-audio-1.0/brief-contract.md",
    "edit_assembly": "jianying-pro-editable-draft",
    "optional_preview_assembly": "hyperframes-on-explicit-request",
    "legacy_voice_catalog": "production/config/voices.json"
  },
  "dfcine": {
    "compute_provider": "AutoDL",
    "preferred_video_workflow": "h3.ref.cloud",
    "image_generation_policy": "all_images_codex_imagegen_then_upload_to_dfcine",
    "image_generation_model": "gpt-image-2",
    "image_generation_runner": "codex_builtin_imagegen",
    "image_generation_upload_required": true
  }
}
