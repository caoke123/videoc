# AutoDL developer token; this repository is public.
/production/config/autodl.env
/production/config/media-store.env
/production/config/autodl-runtime.json
/production/config/autodl-watchdog.log
/production/config/elevenlabs.env
# 无限画布渠道配置备份，含各渠道 API Key
/production/config/channels.json
# 无限画布自定义提示词来源备份
/production/config/prompt-sources.json

# 每个批次目录下的生成/预览/验证二进制素材：不进版本控制，
# brief/shot-plan/review 等 JSON 与 prompts/*.md 仍然跟踪
production/jobs/**/*.png
production/jobs/**/*.jpg
production/jobs/**/*.jpeg
production/jobs/**/*.webp
production/jobs/**/*.gif
production/jobs/**/*.mp4
production/jobs/**/*.mov
production/jobs/**/*.wav
production/jobs/**/*.mp3

# 旧 HyperFrames 预览工程的构建产物
/production/jobs/*/edit/hyperframes/node_modules/
/production/jobs/*/edit/hyperframes/media/
/production/jobs/*/edit/hyperframes/snapshots/
/production/jobs/*/edit/hyperframes/renders/

# 纯试验/临时目录：整目录不进 git
# 原 /test/ /output/ /outputs/ /work/ 已合并为统一的 /scratch/
/scratch/

# Python 编译缓存（不止 postproduction 一处会出现）
__pycache__/
*.pyc

# Node 依赖（防止未来其它子项目引入 node_modules 又被误提交）
node_modules/

# autodl-video-workbench 部署打包快照：内容与 dist/ 重复，需要时现场重新打包
autodl-video-workbench/*.tar.gz

# autodl-video-workbench/web 的 Vite 构建产物：真正的构建输出，不是源码，
# 旧版手写 dist/ 在切换前继续保留、继续跟踪
autodl-video-workbench/web-dist/

# infinite-canvas 评估分支：vendored 快照的构建产物/依赖，不进版本控制
infinite-canvas/web/node_modules/
infinite-canvas/web/dist/

# 无限画布导出/合并出来的配置文件含各渠道 API Key，绝不入库
infinite-canvas-config*.json
# 素材迁移隔离区：本地回滚用，确认无误后用 --purge --yes 删除
production/jobs/_migrated-duplicates/
autodl-video-workbench/runner.*.log

# 工作台生成图片及其索引是本地业务数据
/production/generated-images/

# 完整生图记录和参考图快照属于本地业务数据
/production/image-history/

# 跨浏览器共享文件、资产与历史，以及迁移前的业务数据备份
/production/canvas-storage/
/production/backups/
/production/config/channels*.json

# 剪映草稿导出组件：第三方仓库克隆和 venv，由 setup-jianying-exporter.mjs 安装
/tools/jianying-exporter/
